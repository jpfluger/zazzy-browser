    "mocha": "^11.7.5",
    "node-fetch": "^2.0.0",
    "really-need": "^1.9.2",
    "standard": "^17.1.2",
    "supertest": "^7.1.4",
    "terser-webpack-plugin": "^5.2.4",
    "webpack": "^5.96.1",
